# Global Environment Variables
COMPOSE_PROJECT_NAME=nitrite-v2

# Database
POSTGRES_USER=nitrite
POSTGRES_PASSWORD=nitritepassword
POSTGRES_DB=nitrite
DATABASE_URL=postgresql+asyncpg://nitrite:nitritepassword@postgres:5432/nitrite

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
SECRET_KEY=change-this-super-secret-key-in-production
DEBUG=True
APP_NAME=NiTriTe API
APP_VERSION=2.0.0

# CORS (add your domains here)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# Frontend
VITE_API_URL=http://localhost:8000
